#define MHPMCOUNTER_BITMAP 0xFFFFFFF8

/ {

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			reg = <0>;
			device_type = "cpu";
			status = "okay";
			next-level-cache = <&l2_0>;
			compatible = "syntacore,scr9", "riscv";
			riscv,isa = "rv64imafdc_zicond_zba_zbb_zbc_zbs_sscofpmf";
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "zicond", "zba", "zbb", "zbc", "zbs", "sscofpmf";
			mmu-type = "riscv,sv39";
			d-cache-block-size = <16>;
			d-cache-sets = <512>;
			d-cache-size = <32768>;
			i-cache-block-size = <16>;
			i-cache-sets = <512>;
			i-cache-size = <32768>;
			riscv,cbom-block-size = <32>;
			opensbi-domain = <&tdomain>;
			clock-frequency = <CPUCLK>;

			l2_0: l2-cache {
				compatible = "cache";
				cache-unified;
				next-level-cache = <&l3>;
				cache-level = <2>;
				cache-block-size = <32>;
				cache-sets = <0x800>;
				cache-size = <0x80000>;
			};

			cpu0_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				#interrupt-cells = <1>;
				#address-cells = <0>;
			};
		};

		cpu1: cpu@1 {
			reg = <1>;
			device_type = "cpu";
			status = "okay";
			next-level-cache = <&l2_1>;
			compatible = "syntacore,scr9", "riscv";
			riscv,isa = "rv64imafdc_zicond_zba_zbb_zbc_zbs_sscofpmf";
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "zicond", "zba", "zbb", "zbc", "zbs", "sscofpmf";
			mmu-type = "riscv,sv39";
			d-cache-block-size = <16>;
			d-cache-sets = <512>;
			d-cache-size = <32768>;
			i-cache-block-size = <16>;
			i-cache-sets = <512>;
			i-cache-size = <32768>;
			riscv,cbom-block-size = <32>;
			opensbi-domain = <&tdomain>;
			clock-frequency = <CPUCLK>;

			l2_1: l2-cache {
				compatible = "cache";
				cache-unified;
				next-level-cache = <&l3>;
				cache-level = <2>;
				cache-block-size = <32>;
				cache-sets = <0x800>;
				cache-size = <0x80000>;
			};

			cpu1_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				#interrupt-cells = <1>;
				#address-cells = <0>;
			};
		};

		cpu2: cpu@2 {
			reg = <2>;
			device_type = "cpu";
			status = "okay";
			next-level-cache = <&l2_2>;
			compatible = "syntacore,scr9", "riscv";
			riscv,isa = "rv64imafdc_zicond_zba_zbb_zbc_zbs_sscofpmf";
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "zicond", "zba", "zbb", "zbc", "zbs", "sscofpmf";
			mmu-type = "riscv,sv39";
			d-cache-block-size = <16>;
			d-cache-sets = <512>;
			d-cache-size = <32768>;
			i-cache-block-size = <16>;
			i-cache-sets = <512>;
			i-cache-size = <32768>;
			riscv,cbom-block-size = <32>;
			opensbi-domain = <&tdomain>;
			clock-frequency = <CPUCLK>;

			l2_2: l2-cache {
				compatible = "cache";
				cache-unified;
				next-level-cache = <&l3>;
				cache-level = <2>;
				cache-block-size = <32>;
				cache-sets = <0x800>;
				cache-size = <0x80000>;
